# Copia este archivo a .env y rellénalo. Nunca subas .env al repositorio.
GOCONTACT_BASE=https://TU-DOMINIO.gocontact.es/poll
GOCONTACT_USER=usuario_servicio@dominio
GOCONTACT_PASS=cambia-esto

# templateId de las plantillas del Report Designer
GC_TEMPLATE_LEADS=0
GC_TEMPLATE_VENTAS=0
GC_TEMPLATE_LLAMADAS=0
# Opcionales: plantillas específicas para colas
GC_TEMPLATE_VENTAS_COLAS=
GC_TEMPLATE_LLAMADAS_COLAS=

# Opcionales: limitar a ciertas campañas / colas (ids separados por comas). Vacío = todas.
GC_CAMPAIGN_IDS=
GC_QUEUE_IDS=

# stdio = local en Claude Desktop | streamable-http = servidor remoto
MCP_TRANSPORT=stdio
HOST=127.0.0.1
PORT=8000
# GC_CONFIG=config/business_rules.json
